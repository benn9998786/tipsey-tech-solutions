# Copy this file to .env (or set these in the Render dashboard) and fill in the values.

# ---- Required ----
# Password for the /admin dashboard. Use a long random string.
ADMIN_PASSWORD=change-me-to-something-long
ADMIN_USER=admin

# Where quote notifications get emailed.
NOTIFY_EMAIL=you@yourdomain.com

# ---- Email (any SMTP provider works) ----
# Resend:    smtp.resend.com   port 587   user "resend"  pass = your API key
# SendGrid:  smtp.sendgrid.net port 587   user "apikey"  pass = SG.xxxxx
# Gmail:     smtp.gmail.com   port 465   user = address  pass = app password
# Fastmail:  smtp.fastmail.com port 465  user = address  pass = app password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The "from" address on notifications. Some providers require one you own/verified.
MAIL_FROM="Tipsey Tech Website" <notifications@yourdomain.com>

# ---- Storage (optional but recommended) ----
# Without this, saved enquiries are stored on disk and are WIPED on every redeploy.
# The email is the permanent record either way.
# Create a free Postgres at https://render.com and paste its connection string:
DATABASE_URL=
DATABASE_SSL=true

# ---- Misc ----
# Comma-separated origins allowed to POST to the API (your marketing site).
ALLOWED_ORIGIN=https://tipsey-tech-solutions.onrender.com
# Max submissions per IP per hour.
RATE_LIMIT_PER_HOUR=10